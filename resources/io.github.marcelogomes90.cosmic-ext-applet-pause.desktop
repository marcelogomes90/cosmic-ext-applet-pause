[Desktop Entry]
Name=Pause
Comment=Small break reminders for the COSMIC desktop
Comment[cs]=Připomínky krátkých přestávek pro prostředí COSMIC
Comment[de]=Erinnerungen an kleine Pausen für den COSMIC-Desktop
Comment[es]=Recordatorios de pausas breves para el escritorio COSMIC
Comment[fr]=Rappels de petites pauses pour le bureau COSMIC
Comment[it]=Promemoria di piccole pause per il desktop COSMIC
Comment[nl]=Herinneringen aan korte pauzes voor de COSMIC-desktop
Comment[pl]=Przypomnienia o krótkich przerwach dla pulpitu COSMIC
Comment[pt_BR]=Lembretes de pequenas pausas para a área de trabalho COSMIC
Comment[ru]=Напоминания о коротких перерывах для рабочего стола COSMIC
Comment[uk]=Нагадування про короткі перерви для стільниці COSMIC
Comment[zh_CN]=COSMIC 桌面的小憩提醒
Type=Application
Exec=cosmic-ext-applet-pause
Icon=io.github.marcelogomes90.cosmic-ext-applet-pause
Terminal=false
Categories=COSMIC;
Keywords=COSMIC;Applet;Break;Reminder;Health;Timer;Pause;Ergonomics;
Keywords[cs]=COSMIC;Applet;Přestávka;Připomínka;Zdraví;Časovač;Pauza;Ergonomie;
Keywords[de]=COSMIC;Applet;Pause;Erinnerung;Gesundheit;Timer;Ergonomie;
Keywords[es]=COSMIC;Applet;Pausa;Recordatorio;Salud;Temporizador;Ergonomía;
Keywords[fr]=COSMIC;Applet;Pause;Rappel;Santé;Minuteur;Ergonomie;
Keywords[it]=COSMIC;Applet;Pausa;Promemoria;Salute;Timer;Ergonomia;
Keywords[nl]=COSMIC;Applet;Pauze;Herinnering;Gezondheid;Timer;Ergonomie;
Keywords[pl]=COSMIC;Applet;Przerwa;Przypomnienie;Zdrowie;Minutnik;Ergonomia;
Keywords[pt_BR]=COSMIC;Applet;Pausa;Lembrete;Saúde;Temporizador;Ergonomia;
Keywords[ru]=COSMIC;Applet;Перерыв;Напоминание;Здоровье;Таймер;Эргономика;
Keywords[uk]=COSMIC;Applet;Перерва;Нагадування;Здоров'я;Таймер;Ергономіка;
Keywords[zh_CN]=COSMIC;Applet;休息;提醒;健康;计时器;人体工学;
NoDisplay=true
StartupNotify=true
X-CosmicApplet=true
X-CosmicShrinkable=true
X-CosmicHoverPopup=Auto
X-OverflowPriority=70
X-OverflowMinSize=1
